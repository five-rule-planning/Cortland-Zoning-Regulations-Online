knitr::opts_chunk$set(echo = TRUE)
library(kableExtra)
library(tidyverse)
library(sf)
library(mapview)
mainColor <- "#90D5FF"
mainColorDark <- "#8A817C"
contrast1 <- "#a40707"
contrast2 <- "#6600FF"
typefaceDark <- "#0047AB"
r1 <- data.frame("Type" = c("Single Family Dwelling", "Two Family Dwelling", "Other Permitted Uses"),
"Lot Area (Sq. Ft.)" = c("14,000", "7,000 per family", "14,000"),
"Required Front Yard" = c("25'", "25'", "25'"),
"Required Side Yard" = c("7'", "7'", "7'"),
"Required Rear Yard" = c("30'", "30'", "30'"),
"Height" = c("35'", "35'", "35'")
)
colnames(r1) <- c("Type", "Lot Area (Sq. Ft.)", "Required Front Yard", "Required Side Yard", "Required Rear Yard", "Height")
knitr::kable(r1, align = c("l", "c", "c", "c", "c", "c"),
longtable = TRUE) %>%
kable_styling(bootstrap_options = c("striped", "hover"), position = "left", full_width = F,
fixed_thead = T, latex_options = c("striped", "HOLD_position", "repeat_header")) %>%
row_spec(row = 0, color = "white", background = "gray") %>%
column_spec(1:6, width = "5em")
library(tidyverse)
quarto::quarto_publish_site()
install.packages("quarto")
quarto::quarto_publish_site()
